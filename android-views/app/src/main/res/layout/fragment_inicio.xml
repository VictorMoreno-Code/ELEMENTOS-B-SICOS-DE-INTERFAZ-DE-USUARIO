<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: presentación de la app y acceso a las seis secciones -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="@dimen/espacio_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tarjeta de bienvenida con degradado azul -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_encabezado"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Nombre de la app -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceDisplaySmall"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Descripción de la app -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Catálogo interactivo de elementos básicos de interfaz de usuario. Cada elemento muestra su nombre, una explicación breve y una demostración con la que puedes interactuar."
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/white" />

                <!-- Tecnología usada -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Android nativo · Views + XML · Kotlin"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Título de la lista de secciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Secciones"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <!-- Aquí se agregan las seis tarjetas de sección desde el código -->
        <LinearLayout
            android:id="@+id/contenedorSecciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Explicación de la conexión entre secciones -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:descripcion="Las secciones comparten datos: lo que agregues desde la Sección 1 aparece en la lista de la Sección 4, y el interruptor y el deslizador de la Sección 3 cambian lo que se muestra en la Sección 5."
            app:titulo="Conexión entre secciones">

            <!-- Ir a la Sección 1 para probar la conexión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProbarConexion"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Probar la conexión" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
