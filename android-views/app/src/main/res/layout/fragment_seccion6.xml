<?xml version="1.0" encoding="utf-8"?>
<!-- SECCIÓN 6: CONTENEDORES Y ESTRUCTURA -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="@dimen/espacio_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título de la sección -->
        <TextView
            style="@style/Texto.TituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sección 6: Contenedores y estructura" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Elementos que organizan a los demás dentro de la pantalla."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Distribución en fila y en columna -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Un mismo contenedor puede acomodar sus elementos en una fila (horizontal) o en una columna (vertical). Cambia la orientación con los botones y toca una caja."
            app:titulo="Distribución en fila y en columna">

            <!-- Elegir la orientación -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoOrientacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnFila"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnFila"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fila" />

                <Button
                    android:id="@+id/btnColumna"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Columna" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Contenedor con tres cajas -->
            <LinearLayout
                android:id="@+id/contenedorCajas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cajaA"
                    style="@style/Caja.Demo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:text="A" />

                <TextView
                    android:id="@+id/cajaB"
                    style="@style/Caja.Demo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="?attr/colorSecondary"
                    android:text="B"
                    android:textColor="?attr/colorOnSecondary" />

                <TextView
                    android:id="@+id/cajaC"
                    style="@style/Caja.Demo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="?attr/colorTertiary"
                    android:text="C"
                    android:textColor="?attr/colorOnTertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRespuestaCajas"
                style="@style/Texto.Respuesta"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orientación: fila" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Distribución superpuesta -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Los elementos se colocan unos encima de otros. Sirve para poner un texto sobre una imagen o un distintivo sobre un ícono. Toca una caja para traerla al frente."
            app:titulo="Distribución superpuesta">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <TextView
                    android:id="@+id/pila1"
                    style="@style/Caja.Demo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:text="1" />

                <TextView
                    android:id="@+id/pila2"
                    style="@style/Caja.Demo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="?attr/colorSecondary"
                    android:text="2"
                    android:textColor="?attr/colorOnSecondary" />

                <TextView
                    android:id="@+id/pila3"
                    style="@style/Caja.Demo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="50dp"
                    android:backgroundTint="?attr/colorTertiary"
                    android:text="3"
                    android:textColor="?attr/colorOnTertiary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRespuestaPila"
                style="@style/Texto.Respuesta"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al frente: caja 3" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Contenedor con desplazamiento vertical -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Cuando el contenido es más grande que el espacio disponible, un contenedor con desplazamiento permite moverse hacia arriba y abajo. Desliza el recuadro o usa los botones."
            app:titulo="Contenedor con desplazamiento vertical">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollDemo"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="?attr/colorSurfaceContainerLow">

                <TextView
                    android:id="@+id/tvContenidoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrInicio"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ir al inicio" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrFinal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ir al final" />
            </LinearLayout>
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Barra superior con título y acciones -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Barra en la parte superior con el título de la pantalla, un botón de navegación a la izquierda y acciones a la derecha. Los tres puntos abren las acciones extra."
            app:titulo="Barra superior">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarDemo"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimaryContainer"
                app:navigationIcon="@drawable/ic_menu"
                app:title="Mi barra superior"
                app:titleTextColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/tvRespuestaBarra"
                style="@style/Texto.Respuesta"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca una acción de la barra" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Barra de navegación inferior -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Permite cambiar entre las pantallas principales con un toque. Esta app usa un menú lateral para sus secciones; aquí ves una barra inferior funcional con un distintivo de avisos en «Perfil»."
            app:titulo="Barra de navegación inferior">

            <!-- Pantalla que cambia con la barra -->
            <TextView
                android:id="@+id/tvPantallaNav"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="?attr/colorSurfaceContainerLow"
                android:gravity="center"
                android:text="Estás en: Inicio"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNavDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_demo_bottom" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Distribución con pesos proporcionales -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:descripcion="Con pesos (layout_weight) cada elemento recibe una parte proporcional del espacio. Mueve el deslizador para cambiar el peso de la caja central."
            app:titulo="Distribución con pesos proporcionales">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Caja.Demo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="1" />

                <TextView
                    android:id="@+id/cajaPesoCentro"
                    style="@style/Caja.Demo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="2"
                    android:backgroundTint="?attr/colorSecondary"
                    android:text="2"
                    android:textColor="?attr/colorOnSecondary" />

                <TextView
                    style="@style/Caja.Demo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorTertiary"
                    android:text="1"
                    android:textColor="?attr/colorOnTertiary" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="2"
                android:valueFrom="1"
                android:valueTo="6" />

            <TextView
                android:id="@+id/tvRespuestaPeso"
                style="@style/Texto.Respuesta"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proporción 1 : 2 : 1" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>

        <!-- Distribución con restricciones -->
        <com.outlook.victoreduardo.xml_ui.TarjetaElemento
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:descripcion="Con ConstraintLayout cada elemento se ancla a otros o a una guía. Aquí las dos cajas están ancladas a una guía vertical; mueve el deslizador para desplazar la guía."
            app:titulo="Distribución con restricciones">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="80dp">

                <!-- Guía vertical que reparte el espacio -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- Caja anclada entre el borde izquierdo y la guía -->
                <TextView
                    android:id="@+id/cajaIzquierda"
                    style="@style/Caja.Demo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="4dp"
                    android:text="Izquierda"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guia"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Caja anclada entre la guía y el borde derecho -->
                <TextView
                    android:id="@+id/cajaDerecha"
                    style="@style/Caja.Demo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="?attr/colorSecondary"
                    android:text="Derecha"
                    android:textColor="?attr/colorOnSecondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guia"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderGuia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:value="50"
                android:valueFrom="20"
                android:valueTo="80" />

            <TextView
                android:id="@+id/tvRespuestaGuia"
                style="@style/Texto.Respuesta"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guía al 50 % del ancho" />
        </com.outlook.victoreduardo.xml_ui.TarjetaElemento>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
